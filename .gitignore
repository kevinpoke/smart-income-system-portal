# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local SQLite database (real accounts/sessions/outbox — never commit)
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# support chat image attachments — persisted on the data volume in
# production, never committed to git (see lib/supportUploads.js). This
# is already covered by the /data/ rule above; listed explicitly for
# clarity since it is a new persistent-storage location added in this
# batch.
/data/support-uploads/

# refinement pass: user-uploaded profile photos -- never commit real
# uploaded images; keep the directory structure via .gitkeep only.
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
